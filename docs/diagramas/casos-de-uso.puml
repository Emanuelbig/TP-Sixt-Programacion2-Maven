@startuml casos-de-uso
' Casos de uso por actor, con la misma numeracion que el documento de evaluacion.
' Que puede hacer cada uno lo deciden los permisos de su rol inicial:
'   Cliente: ALQUILAR | Vendedor: VENDER + ADMINISTRAR_CLIENTES | Administrador: ADMINISTRAR + los del vendedor
title Sixt - Diagrama de casos de uso

left to right direction
skinparam shadowing false
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #FFFFFF
  BorderColor #1A1A1A
  ArrowColor #1A1A1A
}
skinparam package {
  BorderColor #656A6F
}

actor "Usuario" as usuario
actor "Cliente" as cliente
actor "Vendedor" as vendedor
actor "Administrador" as admin

' Todos son usuarios. El administrador inicial tambien tiene los permisos del vendedor
usuario <|-- cliente
usuario <|-- vendedor
vendedor <|-- admin

rectangle "Sistema Sixt" {
  package "Comunes" {
    usecase "CU01\nIniciar sesion" as CU01
    usecase "CU02\nConsultar inicio" as CU02
    usecase "CU03\nConsultar mi cuenta\ny cambiar contrasenia" as CU03
    usecase "CU04\nCerrar sesion" as CU04
  }

  package "Administracion" {
    usecase "CU05\nGestionar oficinas" as CU05
    usecase "CU06\nGestionar catalogo\n(modelos, tipos y precios)" as CU06
    usecase "CU07\nGestionar vehiculos" as CU07
    usecase "CU08\nGestionar personas" as CU08
    usecase "CU09\nGestionar roles" as CU09
  }

  package "Ventas" {
    usecase "CU10\nGestionar clientes" as CU10
    usecase "CU11\nRegistrar reserva asistida" as CU11
    usecase "CU12\nRegistrar devolucion" as CU12
    usecase "CU16\nCancelar reserva" as CU16
  }

  package "Alquiler" {
    usecase "CU13\nReservar online" as CU13
    usecase "CU14\nConsultar mis reservas" as CU14
    usecase "CU17\nCancelar mi reserva" as CU17
  }

  usecase "CU15\nBuscar disponibilidad" as CU15
}

usuario --> CU01
usuario --> CU02
usuario --> CU03
usuario --> CU04

admin --> CU05
admin --> CU06
admin --> CU07
admin --> CU08
admin --> CU09

vendedor --> CU10
vendedor --> CU11
vendedor --> CU12
vendedor --> CU16

cliente --> CU13
cliente --> CU14
cliente --> CU17

CU11 ..> CU15 : <<include>>
CU13 ..> CU15 : <<include>>

note right of CU15
  Devuelve los vehiculos activos sin reservas
  vigentes (ni devueltas ni canceladas)
  que se superpongan con las fechas.
end note

@enduml
